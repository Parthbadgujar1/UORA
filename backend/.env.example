# Backend environment variables (see ../.env.example for the full annotated list).
# Copy this file to backend/.env and fill in real values. NEVER commit backend/.env.

NODE_ENV=production
PORT=5000

DATABASE_URL=mysql://uora_user:STRONG_PASSWORD@localhost:3306/uora

JWT_SECRET=replace-with-a-random-64-char-secret
JWT_EXPIRES_IN=1h
JWT_ISSUER=uora-api
JWT_AUDIENCE=uora-client

REFRESH_EXPIRES_DAYS=14
PASSWORD_RESET_EXPIRES_MINUTES=60
EMAIL_VERIFY_EXPIRES_HOURS=24

BODY_LIMIT=1mb
MAX_UPLOAD_BYTES=20971520

FRONTEND_URL=https://uorapublications.com
CORS_ORIGINS=https://uorapublications.com,https://www.uorapublications.com

# Admin bootstrap
ADMIN_EMAIL=admin@uorapublications.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=UORA Administrator

# ---------------------------------------------------------------------------
# Email / SMTP — set all four to enable password reset & email verification.
# When any of MAIL_HOST / MAIL_USER / MAIL_PASS is missing, email is disabled
# but the server still starts normally.
# ---------------------------------------------------------------------------
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=no-reply@uorapublications.com
MAIL_PASS=replace-with-mailbox-password
MAIL_FROM=UORA Publications <no-reply@uorapublications.com>
