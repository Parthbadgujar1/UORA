# =============================================================================
# UORA Backend — PRODUCTION environment variable template for Hostinger
#
# HOW TO USE:
#   Do NOT copy this file to the server. Instead, paste each variable directly
#   into Hostinger hPanel → Hosting → Node.js → your backend app
#   → "Environment Variables" panel.
#
# Placeholders marked <<REPLACE_*>> must be filled in before deploying.
# =============================================================================

# --- Node / runtime ----------------------------------------------------------
NODE_ENV=production
PORT=5000

# --- Database (Hostinger MySQL) -----------------------------------------------
# Find these in hPanel → Databases → MySQL Databases
# Format: mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
# connection_limit caps concurrent DB connections this app opens — keep it
# comfortably under your MySQL plan's max_connections (shared Hostinger MySQL
# plans are often quite low). 5 is a safe starting point for a single Node
# process on a 2-core/3GB plan.
DATABASE_URL=mysql://<<REPLACE_DB_USER>>:<<REPLACE_DB_PASSWORD>>@localhost:3306/<<REPLACE_DB_NAME>>?connection_limit=5

# --- Auth / JWT ---------------------------------------------------------------
# REQUIRED. Must be >= 32 characters in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<<REPLACE_WITH_64_CHAR_RANDOM_HEX>>
JWT_EXPIRES_IN=1h
JWT_ISSUER=uora-api
JWT_AUDIENCE=uora-client

# --- Token lifetimes ----------------------------------------------------------
REFRESH_EXPIRES_DAYS=14
PASSWORD_RESET_EXPIRES_MINUTES=60
EMAIL_VERIFY_EXPIRES_HOURS=24

# --- Body / upload limits -----------------------------------------------------
BODY_LIMIT=1mb
MAX_UPLOAD_BYTES=20971520

# --- CORS ---------------------------------------------------------------------
# Must exactly match the browser origin (scheme + hostname + no trailing slash).
FRONTEND_URL=https://uorapublications.com
CORS_ORIGINS=https://uorapublications.com,https://www.uorapublications.com

# --- Reverse proxy -------------------------------------------------------------
# Number of proxy hops in front of this app on Hostinger. Wrong here can make
# rate limiting share one bucket across many real visitors — confirm the real
# hop count with Hostinger support if unsure; 1 is correct for a single
# reverse proxy/load balancer (the common case).
TRUST_PROXY_HOPS=1

# --- Admin bootstrap ----------------------------------------------------------
# Used by: cd backend && npx tsx prisma/seed.ts
# Run this ONCE after the first deploy to create the admin account.
ADMIN_EMAIL=<<REPLACE_ADMIN_EMAIL>>
ADMIN_PASSWORD=<<REPLACE_ADMIN_PASSWORD_STRONG>>
ADMIN_NAME=<<REPLACE_ADMIN_DISPLAY_NAME>>

# Emergency admin recovery, independent of the seed script above. Set to a
# long random secret (openssl rand -hex 32) and keep it private — leave unset
# to disable the endpoint entirely. See backend/prisma/migrations/README.md
# is unrelated; see README's auth section / DEPLOY.md for how it's used.
ADMIN_BOOTSTRAP_SECRET=<<REPLACE_WITH_LONG_RANDOM_SECRET_OR_LEAVE_UNSET>>

# --- Email / SMTP (Hostinger) -------------------------------------------------
# All six vars must be set for password reset & email verification to work.
# In hPanel: Emails → Manage → pick / create no-reply@uorapublications.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@uorapublications.com
SMTP_PASS=<<REPLACE_EMAIL_MAILBOX_PASSWORD>>
SMTP_FROM=UORA Publications <no-reply@uorapublications.com>

# --- Rate limits (optional — defaults are shown) ------------------------------
# Uncomment and adjust only if you need to tune for traffic volume.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=600
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=50
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# RESET_RATE_LIMIT_WINDOW_MS=3600000
# RESET_RATE_LIMIT_MAX=5
# SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
# SENSITIVE_RATE_LIMIT_MAX=100

# --- Node memory (optional but recommended on a 3GB Hostinger plan) -----------
# Caps the V8 heap so this process can never alone exhaust the box's RAM
# (shared with MySQL, the frontend app, and PHP workers). Set as an
# Environment Variable in hPanel if your Node.js app plan honours it, or
# prefix the start command with it (see DEPLOY.md "Performance & resource
# tuning").
# NODE_OPTIONS=--max-old-space-size=384
