# Frontend environment variables.
# NEXT_PUBLIC_* vars are inlined at build time — set them in Hostinger's
# "Environment variables" panel BEFORE building, otherwise they are empty.
#
# Public URL of the deployed backend. Leave unset to use the same-origin
# Next.js /api rewrite (which forwards to BACKEND_URL).
# NEXT_PUBLIC_API_URL=https://api.uorapublications.com

# Build-time backend origin for the Next.js /api rewrite (same-origin proxying).
# BACKEND_URL=http://localhost:5000
