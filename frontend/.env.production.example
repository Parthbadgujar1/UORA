# =============================================================================
# UORA Frontend — PRODUCTION environment variable template for Hostinger
#
# HOW TO USE:
#   Set these as build-time env vars in Hostinger hPanel → Hosting → Node.js
#   → your frontend app → "Environment Variables" panel BEFORE triggering a
#   build. NEXT_PUBLIC_* values are inlined at build time — if they are not
#   set before the build runs, they will be empty in the production bundle.
#
# Placeholders marked <<REPLACE_*>> must be filled in before deploying.
# =============================================================================

# Public URL of the deployed backend (Express API on port 5000).
# The browser uses this directly — it must be the public HTTPS URL.
# Example if backend is on a subdomain: https://api.uorapublications.com
# Example if backend is on same domain via proxy: leave unset and use BACKEND_URL below.
NEXT_PUBLIC_API_URL=https://<<REPLACE_BACKEND_PUBLIC_URL>>

# ---------------------------------------------------------------------------
# Same-origin proxy alternative (only if both apps share one hostname/port)
# If NEXT_PUBLIC_API_URL is set, this is NOT needed (it's only used by
# next.config.ts rewrites which are bypassed when the browser calls directly).
# ---------------------------------------------------------------------------
# BACKEND_URL=http://localhost:5000
