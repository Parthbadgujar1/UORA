# =============================================================================
# UORA — Environment variable examples
#
# Copy the values you need into backend/.env and (if applicable) set them as
# build-time vars for the frontend. NEVER commit real secrets.
#
# Backend (backend/.env) — all values except the documented fallbacks are
# REQUIRED at runtime. The backend refuses to start if DATABASE_URL or
# JWT_SECRET are missing, and (in production) if JWT_SECRET is under 32 chars.
# =============================================================================

# --- Node / runtime --------------------------------------------------------
NODE_ENV=production
PORT=5000

# --- Database (Hostinger MySQL) -------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME?connection_limit=5
# The connection_limit query param caps how many DB connections this app
# opens at once — set it explicitly and comfortably under your MySQL plan's
# max_connections (shared Hostinger MySQL plans are often quite low). Without
# it, Prisma's default pool size scales with CPU count and can silently hit
# the ceiling under load.
DATABASE_URL=mysql://uora_user:STRONG_PASSWORD@localhost:3306/uora?connection_limit=5

# --- Auth / JWT ------------------------------------------------------------
# REQUIRED. In production MUST be >= 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-64-char-secret
JWT_EXPIRES_IN=1h
JWT_ISSUER=uora-api
JWT_AUDIENCE=uora-client

# --- Token lifetimes -------------------------------------------------------
REFRESH_EXPIRES_DAYS=14
PASSWORD_RESET_EXPIRES_MINUTES=60
EMAIL_VERIFY_EXPIRES_HOURS=24

# --- Body / upload limits --------------------------------------------------
BODY_LIMIT=1mb
MAX_UPLOAD_BYTES=20971520

# --- Reverse proxy ----------------------------------------------------------
# Number of proxy hops in front of this app on Hostinger (used for rate-limit
# and audit-log IP resolution via Express "trust proxy"). 1 is correct for a
# single reverse proxy/load balancer in front of the app; if Hostinger puts
# more than one hop in front of it (e.g. a CDN AND a load balancer), this MUST
# be increased to the real hop count, or every visitor's rate limit can be
# silently shared across one shared proxy IP. If unsure, ask Hostinger support
# how many hops sit in front of your Node.js app.
TRUST_PROXY_HOPS=1

# --- CORS ------------------------------------------------------------------
# The public URL(s) of the frontend, comma-separated. Must match the browser
# origin exactly or CORS will reject requests.
FRONTEND_URL=https://uorapublications.com
CORS_ORIGINS=https://uorapublications.com,https://www.uorapublications.com

# --- Security / rate limits (optional, defaults shown) --------------------
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=600
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=50
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# RESET_RATE_LIMIT_WINDOW_MS=3600000
# RESET_RATE_LIMIT_MAX=5
# SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
# SENSITIVE_RATE_LIMIT_MAX=100

# --- Admin bootstrap (prisma:seed / ensure-admin) --------------------------
ADMIN_EMAIL=admin@uorapublications.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=UORA Administrator

# Emergency admin recovery, independent of the DB seed above. Set this to a
# long random secret and keep it private. POST /api/auth/bootstrap-admin with
# header `x-bootstrap-secret: <this value>` creates (or resets the password of)
# the ADMIN_EMAIL account. Leave unset to disable the endpoint entirely (it
# refuses every request with 404 when this var is not set).
ADMIN_BOOTSTRAP_SECRET=replace-with-a-long-random-secret-or-leave-unset-to-disable

# --- Email (SMTP) -----------------------------------------------------------
# Password reset / email verification are sent via backend/src/security/mailer.ts.
# Set ALL of these to enable delivery — if any are missing, email delivery is
# disabled and requests still succeed (no 500s) but nothing is sent.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@uorapublications.com
SMTP_PASS=replace-with-mailbox-password
SMTP_FROM=UORA Publications <no-reply@uorapublications.com>

# =============================================================================
# Frontend (frontend/.env or NEXT_PUBLIC_* set as build-time vars in Hostinger)
#
# NEXT_PUBLIC_API_URL — public URL of the deployed backend. If unset, the app
# uses the same-origin Next.js /api rewrite (which forwards to BACKEND_URL).
# =============================================================================
# NEXT_PUBLIC_API_URL=https://api.uorapublications.com

# Build-time backend origin for the Next.js /api rewrite (same-origin proxying).
# BACKEND_URL=http://localhost:5000
